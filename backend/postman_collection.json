{
  "info": {
    "name": "Anomaly Detection API",
    "description": "Full backend flow: register → login → upload → train → predict → anomalies → settings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001" },
    { "key": "token", "value": "" },
    { "key": "datasetId", "value": "" },
    { "key": "modelId", "value": "" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sara@example.com\",\n  \"password\": \"pass1234\"\n}"
        }
      }
    },
    {
      "name": "2. Login (saves token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.access_token) { pm.collectionVariables.set('token', body.access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sara@example.com\",\n  \"password\": \"pass1234\"\n}"
        }
      }
    },
    {
      "name": "3. Me (verify token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "4. Upload CSV (saves datasetId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.dataset_id) { pm.collectionVariables.set('datasetId', body.dataset_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/upload",
          "host": ["{{baseUrl}}"],
          "path": ["upload"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": "" }]
        }
      }
    },
    {
      "name": "5. List datasets",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/upload",
          "host": ["{{baseUrl}}"],
          "path": ["upload"]
        }
      }
    },
    {
      "name": "6. Train (async, 202)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/train/{{datasetId}}",
          "host": ["{{baseUrl}}"],
          "path": ["train", "{{datasetId}}"]
        }
      }
    },
    {
      "name": "7. List models (poll until status=ready, saves modelId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const arr = pm.response.json();",
              "const ready = arr.find(m => m.status === 'ready');",
              "if (ready) { pm.collectionVariables.set('modelId', ready.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/train/models",
          "host": ["{{baseUrl}}"],
          "path": ["train", "models"]
        }
      }
    },
    {
      "name": "8. Predict on new CSV",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/predict/{{modelId}}",
          "host": ["{{baseUrl}}"],
          "path": ["predict", "{{modelId}}"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": "" }]
        }
      }
    },
    {
      "name": "9. List anomalies (saves eventId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const arr = pm.response.json();",
              "if (arr.length) { pm.collectionVariables.set('eventId', arr[0].id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/anomalies?model_id={{modelId}}",
          "host": ["{{baseUrl}}"],
          "path": ["anomalies"],
          "query": [{ "key": "model_id", "value": "{{modelId}}" }]
        }
      }
    },
    {
      "name": "10. Label anomaly as false positive",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/anomalies/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["anomalies", "{{eventId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"false_positive\",\n  \"note\": \"tested from Postman\"\n}"
        }
      }
    },
    {
      "name": "11. Get current threshold",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/settings/threshold/{{modelId}}",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "threshold", "{{modelId}}"]
        }
      }
    },
    {
      "name": "12. Recalibrate threshold (change z)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/settings/threshold/{{modelId}}",
          "host": ["{{baseUrl}}"],
          "path": ["settings", "threshold", "{{modelId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"z_multiplier\": 2.5\n}"
        }
      }
    }
  ]
}
